# Mirada Larga — plantilla de variables de entorno.
#
# Este fichero SÍ se versiona y NUNCA lleva valores reales (Plan §16).
# Copia a `.env`, que está en .gitignore, y rellena allí.
# Si un secreto llega alguna vez al historial de git: rótalo de inmediato.
# Borrar el fichero en un commit posterior NO lo retira del historial.

# ── Base de datos (Neon, región UE) ─────────────────────────────────────────
# El usuario del runtime web es de SOLO LECTURA. Solo los jobs escriben.
DATABASE_URL=
DATABASE_URL_DIRECT=

# ── Streaming Availability API (Movie of the Night) ─────────────────────────
# Credencial exclusiva de los jobs. La web NUNCA la recibe: ninguna petición de
# usuario puede provocar una llamada externa (CLAUDE.md, regla 1).
STREAMING_AVAILABILITY_API_KEY=
STREAMING_API_BASE_URL=

# Presupuesto de cuota. El corte automatico vive en jobs/ops/presupuesto.ts y se
# contabiliza en ops_sync_runs. Un valor invalido aborta al arrancar: no hay
# vuelta atras silenciosa a un valor por defecto.
#
#   MONTHLY_BUDGET   el bruto contractual del plan (Free: 1.000/mes)
#   STOP_FRACTION    fraccion de corte, en (0, 1]. 0.90 -> se gastan 900
#   CYCLE_DAY        dia de inicio del ciclo, 1-28, en Europe/Madrid.
#                    El dia real de renovacion del proveedor NO esta
#                    confirmado; mientras tanto, dia 1. Es configurable
#                    justamente porque lo desconocemos.
STREAMING_API_MONTHLY_BUDGET=1000
STREAMING_API_BUDGET_STOP_FRACTION=0.90
STREAMING_API_BUDGET_CYCLE_DAY=1

# ── DOS MAPAS, DOS UNIDADES. No son intercambiables ─────────────────────────
#
# Forma: "nombre=entero,nombre=entero". Un nombre fuera del vocabulario
# cerrado aborta. En ambos, 0 significa NO AUTORIZADO, nunca "sin limite".
#
#   MONTHLY_PIPELINE_BUDGETS  requests por CICLO MENSUAL.
#                             Solo cifras cuya unidad sea de verdad mensual.
#   PER_RUN_CAPS              tope duro de subrequests de UNA ejecucion
#                             (Plan 8.5). Configuracion INDEPENDIENTE: no se
#                             deriva jamas del techo mensual. Ese fallback
#                             existio y convirtio el cerrojo en un adorno.
#
# Invariante: si ambos son > 0, PER_RUN_CAPS <= MONTHLY_PIPELINE_BUDGETS,
# salvo excepcion escrita en EXCEPCIONES_AL_INVARIANTE.
#
# Vacios = los valores por defecto del repositorio, que hoy dejan todos los
# topes por ejecucion a 0: ningun job esta aprobado para gastar API.
STREAMING_API_MONTHLY_PIPELINE_BUDGETS=
STREAMING_API_PER_RUN_CAPS=

# ── Fuentes complementarias ─────────────────────────────────────────────────
YOUTUBE_API_KEY=

# TMDB queda DESACTIVADO mientras no haya licencia comercial (CLAUDE.md, regla 4).
TMDB_API_KEY=
TMDB_COMMERCIAL_LICENSE=false

# ── Sitio ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DEFAULT_COUNTRY=ES

# ── Revalidación e indexación ───────────────────────────────────────────────
REVALIDATE_SECRET=
INDEXNOW_KEY=

# ── Cloudflare ──────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NEXT_PUBLIC_CF_BEACON_TOKEN=

# ── Monetización (Fase 5, desactivada) ──────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADS_ENABLED=false
AMAZON_ASSOCIATES_TAG=
