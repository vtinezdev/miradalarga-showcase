{
  "name": "mirada-larga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mirada Larga — guía editorial del streaming en España.",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && tsx scripts/verificar-artefacto-web.ts",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:preflight:validation": "tsx scripts/preflight-migracion.ts",
    "db:migrate:validation": "drizzle-kit migrate --config=drizzle.migrate.config.ts",
    "db:preflight:production": "tsx scripts/production-preflight.ts",
    "db:migrate:production": "tsx scripts/production-migrar.ts",
    "db:validate:schema": "tsx scripts/validate-schema-v1.ts",
    "db:validate:behavior": "tsx scripts/validate-behavior-v1.ts",
    "db:validate:schema:production": "tsx scripts/validate-schema-v1.ts --production",
    "db:validate:behavior:production": "tsx scripts/validate-behavior-v1.ts --production",
    "db:validate:import": "tsx scripts/validate-spike1-import.ts",
    "db:validate:ops": "tsx scripts/validate-ops-v1.ts",
    "db:validate:checkpoint": "tsx scripts/validate-checkpoint-v1.ts",
    "db:validate:catalog-lock": "tsx scripts/validate-catalog-lock-v1.ts",
    "db:leer:sync-run": "tsx scripts/leer-sync-run.ts",
    "db:validate:catalogo": "tsx scripts/validate-catalogo-neon.ts",
    "seed:verificar": "tsx scripts/seed-verificar.ts",
    "seed:crudo-de-ensayo": "tsx scripts/seed-crudo-de-ensayo.ts",
    "seed:cargar": "tsx scripts/seed-cargar.ts",
    "seed:validar": "tsx scripts/seed-validar.ts",
    "seed:validar:primer-deltas": "tsx scripts/seed-validar.ts --primer-deltas",
    "seed:sondear": "tsx scripts/seed-sondear.ts",
    "seed:plan": "tsx scripts/seed-plan.ts",
    "seed:capturar": "tsx scripts/seed-capturar.ts",
    "seed:archivar": "tsx scripts/seed-archivar.ts",
    "seed:primer-deltas": "tsx scripts/seed-primer-deltas.ts",
    "seed:m4": "tsx scripts/seed-m4.ts",
    "seed:post-captura": "tsx scripts/seed-post-captura.ts",
    "production:compuerta": "tsx scripts/production-compuerta.ts",
    "production:cargar": "tsx scripts/seed-cargar.ts --production",
    "production:validar": "tsx scripts/seed-validar.ts --production",
    "production:validar:primer-deltas": "tsx scripts/seed-validar.ts --production --primer-deltas",
    "production:huella": "tsx scripts/seed-huella.ts",
    "production:primer-deltas": "tsx scripts/seed-primer-deltas.ts --production",
    "api:validate:changes": "tsx scripts/validate-changes-live.ts",
    "api:run:deltas": "tsx scripts/run-deltas-manual.ts",
    "api:run:expiring": "tsx scripts/run-expiring-manual.ts",
    "api:run:upcoming": "tsx scripts/run-upcoming-manual.ts",
    "api:run:updated": "tsx scripts/run-updated-manual.ts",
    "job": "tsx jobs/run.ts",
    "ops": "tsx scripts/ops.ts"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@neondatabase/serverless": "1.1.0",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "drizzle-orm": "0.45.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0-beta.10",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4",
    "vitest": "^3.2.4",
    "wrangler": "4.149.0"
  }
}
