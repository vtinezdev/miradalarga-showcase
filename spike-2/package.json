{
  "name": "spike-2",
  "version": "0.0.0",
  "private": true,
  "description": "Spike 2 — validacion de infraestructura (Next.js sobre Cloudflare Workers). DESECHABLE: no es codigo de produccion.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "wrangler": "^4.136.0"
  },
  "type": "module"
}
