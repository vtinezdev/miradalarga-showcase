{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mirada-larga",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Workers Cache para páginas (D9, ADR 0002).
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
  // Sin `kv_namespaces`: el namespace del Spike 2 está borrado y no se crea
  // infraestructura antes de tener despliegue. El binding VINEXT_KV_CACHE se
  // añade cuando se despliegue de verdad (Fase 3), junto con la decisión
  // explícita de qué rutas se pre-renderizan (CLAUDE.md, regla 11).
}
